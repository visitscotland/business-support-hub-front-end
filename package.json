{
  "name": "nuxt-bloomreach-headless-white-label",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "postinstall": "node -p \"require('./node_modules/@visitscotland/component-library/package.json').version\" > .clversion && nuxt prepare",
    "commit": "cz",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "test:smoke": "node ci/dependency-smoke.mjs",
    "test:smoke:browser": "node ci/dependency-smoke.mjs --skip-build",
    "test:smoke:harness": "node ci/dependency-smoke.mjs --skip-build --harness",
    "test:smoke:unit": "node --test tests/dependency-smoke/harness.test.mjs",
    "test:smoke:install": "playwright install chromium",
    "test:smoke:diagnostics": "node ci/smoke-diagnostics.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue,ts}": "eslint"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@playwright/test": "1.64.1",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxt": "^4.6.2"
  },
  "dependencies": {
    "@bloomreach/spa-sdk": "^28.1.0",
    "@bloomreach/vue3-sdk": "^22.0.5",
    "@pinia/nuxt": "^1.0.3",
    "@unhead/vue": "^3.4.3",
    "@visitscotland/component-library": "5.82.2",
    "@vue/devtools-api": "^8.1.5",
    "aws-rum-web": "^3.2.1",
    "axios": "^1.20.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "mitt": "^3.0.0",
    "nuxt-jsonld": "^3.0.0",
    "pinia": "^4.1.0",
    "sass": "^1.105.2",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "unenv": "^1.10.0",
    "vue": "3.5.44",
    "youtube-vue3": "^0.1.15"
  },
  "overrides": {
    "minimist": "latest",
    "minimatch": "^10.2.5",
    "lodash": "^4.18.0",
    "axios": "^1.20.0",
    "vue": "3.5.44",
    "@vue/compiler-core": "3.5.44",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-ssr": "3.5.44",
    "@vue/reactivity": "3.5.44",
    "@vue/runtime-core": "3.5.44",
    "@vue/runtime-dom": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "@vue/shared": "3.5.44",
    "@vue/compiler-sfc": "3.5.44"
  },
  "resolutions": {
    "simple-git": "4.0.2",
    "minimist": "latest",
    "minimatch": "^10.2.5",
    "lodash": "^4.18.0",
    "axios": "^1.20.0",
    "vue": "3.5.44",
    "@vue/compiler-core": "3.5.44",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-ssr": "3.5.44",
    "@vue/reactivity": "3.5.44",
    "@vue/runtime-core": "3.5.44",
    "@vue/runtime-dom": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "@vue/shared": "3.5.44",
    "vite@npm:^8.0.0": "8.3.4",
    "launch-editor": "2.14.2",
    "undici@npm:^6.25.0": "6.29.0",
    "glob@npm:^10.0.0": "10.5.0",
    "nanoid@npm:^3.3.16": "3.3.20",
    "external-editor/tmp": "0.2.6",
    "@aws-rum/web-core/uuid": "11.1.1",
    "postcss-selector-parser": "7.1.6",
    "@vue/compiler-sfc": "3.5.44"
  },
  "config": {
